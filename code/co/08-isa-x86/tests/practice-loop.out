【汇编执行】
玩具机按 32 位 Intel 语法执行，栈向低地址增长。每条指令占 4 字节，只为了给 call 一个返回地址；真题里的 x86 指令是变长的
0x00401000  mov eax, 0
    eax=0x0
0x00401004  mov ecx, 1
    ecx=0x1
0x00401008  cmp ecx, 3
    不写回寄存器。差=0xFFFFFFFE，Cout=0，CF = Cout ⊕ 1 = 1，ZF=0，SF=1，OF=0
    无符号小于，jbe 会转移；有符号小于，jle 会转移
0x0040100C  jg done
    不转移，下一条 0x00401010
0x00401010  add eax, ecx
    eax=0x1，ZF=0，SF=0，CF=0，OF=0
0x00401014  add ecx, 1
    ecx=0x2，ZF=0，SF=0，CF=0，OF=0
0x00401018  jmp again
    转到 0x00401008
0x00401008  cmp ecx, 3
    不写回寄存器。差=0xFFFFFFFF，Cout=0，CF = Cout ⊕ 1 = 1，ZF=0，SF=1，OF=0
    无符号小于，jbe 会转移；有符号小于，jle 会转移
0x0040100C  jg done
    不转移，下一条 0x00401010
0x00401010  add eax, ecx
    eax=0x3，ZF=0，SF=0，CF=0，OF=0
0x00401014  add ecx, 1
    ecx=0x3，ZF=0，SF=0，CF=0，OF=0
0x00401018  jmp again
    转到 0x00401008
0x00401008  cmp ecx, 3
    不写回寄存器。差=0x0，Cout=1，CF = Cout ⊕ 1 = 0，ZF=1，SF=0，OF=0
    无符号相等，jbe 会转移；有符号相等，jle 会转移
0x0040100C  jg done
    不转移，下一条 0x00401010
0x00401010  add eax, ecx
    eax=0x6，ZF=0，SF=0，CF=0，OF=0
0x00401014  add ecx, 1
    ecx=0x4，ZF=0，SF=0，CF=0，OF=0
0x00401018  jmp again
    转到 0x00401008
0x00401008  cmp ecx, 3
    不写回寄存器。差=0x1，Cout=1，CF = Cout ⊕ 1 = 0，ZF=0，SF=0，OF=0
    无符号大于，jbe 不转移；有符号大于，jle 不转移
0x0040100C  jg done
    转到 0x0040101C
0x0040101C  mov eax, eax
    eax=0x6
结果：eax=0x6（6），ZF=0，SF=0，CF=0，OF=0
结构：条件分支、循环
