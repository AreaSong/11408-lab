# 408 关卡的公共构建规则。每关的 CMakeLists.txt 只需一行：
#
#   lab_level()                                   本关不依赖其他关卡
#   lab_level(DEPS lib/03-stack lib/04-queue)     复用其他关卡的代码
#   lab_level(DEPS lib/04-queue@answer)           强制用该关的答案（自己那份还没写完时）
#
# 规则：
#   - mine/ 下每次尝试、answer/ 各算一个「单元」，互相独立编译
#   - 单元里含 main 的 .c 各自成为一个程序，其余 .c 合成本单元的公共库
#   - 依赖关卡默认取 mine/ 中日期最新、且用 ./lab.sh done 标记完成的那次尝试；没有标记过就用 answer/
#   - 所有关卡自动依赖 lib/00-warmup（测试宏 test.h）
#   - 程序名以 _test 结尾：直接运行，退出码为 0 即通过
#   - tests/<程序名>/<用例>.in 与 .out：把 .in 喂给程序，输出必须与 .out 一致

set(LAB_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
get_filename_component(LAB_ROOT "${LAB_ROOT}" ABSOLUTE)
set(LAB_WARMUP "lib/00-warmup")
set(LAB_MAIN_REGEX "^[ \t]*int[ \t]+main[ \t]*\\(")

# lib/02-linked-list -> lib02
function(_lab_level_id level_rel out)
    string(REGEX MATCH "^([a-z]+)/([0-9][0-9])-" _m "${level_rel}")
    set(${out} "${CMAKE_MATCH_1}${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()

# 把一个单元目录里的 .c 分成「含 main 的入口文件」和「其余源文件」
function(_lab_split_sources dir out_mains out_others)
    file(GLOB_RECURSE srcs CONFIGURE_DEPENDS "${dir}/*.c")
    set(mains "")
    set(others "")
    foreach(f IN LISTS srcs)
        # 文件里新增或删掉 main 时需要重新划分，所以把源文件也列为配置依赖
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${f}")
        file(STRINGS "${f}" hit REGEX "${LAB_MAIN_REGEX}")
        if(hit)
            list(APPEND mains "${f}")
        else()
            list(APPEND others "${f}")
        endif()
    endforeach()
    set(${out_mains} "${mains}" PARENT_SCOPE)
    set(${out_others} "${others}" PARENT_SCOPE)
endfunction()

function(_lab_has_code dir out)
    file(GLOB_RECURSE code "${dir}/*.c" "${dir}/*.h")
    if(code)
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

# 选出依赖关卡要用的单元：返回单元名（日期-说明 或 answer）与目录，找不到时为空
# 只采用带 .done 标记（./lab.sh done）的尝试：写到一半的代码不能拖垮依赖它的关卡
function(_lab_pick_unit dep_rel prefer_answer out_name out_dir)
    set(base "${LAB_ROOT}/${dep_rel}")
    set(${out_name} "" PARENT_SCOPE)
    set(${out_dir} "" PARENT_SCOPE)
    if(NOT prefer_answer)
        # 标记的增删要触发重新配置，所以用 CONFIGURE_DEPENDS 盯住 .done
        file(GLOB marks CONFIGURE_DEPENDS "${base}/mine/*/.done")
        list(SORT marks ORDER DESCENDING)
        foreach(m IN LISTS marks)
            get_filename_component(a "${m}" DIRECTORY)
            _lab_has_code("${a}" ok)
            if(ok)
                get_filename_component(name "${a}" NAME)
                set(${out_name} "${name}" PARENT_SCOPE)
                set(${out_dir} "${a}" PARENT_SCOPE)
                return()
            endif()
        endforeach()
    endif()
    _lab_has_code("${base}/answer" ok)
    if(ok)
        set(${out_name} "answer" PARENT_SCOPE)
        set(${out_dir} "${base}/answer" PARENT_SCOPE)
    endif()
endfunction()

# 把依赖列表解析成「要加的头文件目录」和「要链接的公共库目标」
function(_lab_resolve_deps deps prefer_answer out_includes out_targets)
    set(includes "")
    set(targets "")
    foreach(dep IN LISTS deps)
        set(force_answer ${prefer_answer})
        if(dep MATCHES "^(.+)@answer$")
            set(dep "${CMAKE_MATCH_1}")
            set(force_answer TRUE)
        endif()
        _lab_pick_unit("${dep}" ${force_answer} unit dir)
        if(NOT dir)
            message(WARNING "${dep} 还没有任何代码（mine/ 与 answer/ 都为空），依赖它的程序可能编译失败")
            continue()
        endif()
        list(APPEND includes "${dir}")
        _lab_split_sources("${dir}" mains others)
        if(others)
            _lab_level_id("${dep}" dep_id)
            list(APPEND targets "${dep_id}_${unit}_core")
        endif()
    endforeach()
    set(${out_includes} "${includes}" PARENT_SCOPE)
    set(${out_targets} "${targets}" PARENT_SCOPE)
endfunction()

# 为一个程序登记测试
function(_lab_add_tests target stem level_dir labels)
    if(stem MATCHES "_test$")
        add_test(NAME "${target}" COMMAND "${target}")
        set_tests_properties("${target}" PROPERTIES LABELS "${labels}" TIMEOUT 30)
    endif()
    file(GLOB cases CONFIGURE_DEPENDS "${level_dir}/tests/${stem}/*.in")
    foreach(in IN LISTS cases)
        get_filename_component(case "${in}" NAME_WLE)
        get_filename_component(case_dir "${in}" DIRECTORY)
        set(expected "${case_dir}/${case}.out")
        if(NOT EXISTS "${expected}")
            message(WARNING "${in} 缺少对应的标准答案 ${case}.out，已跳过")
            continue()
        endif()
        add_test(NAME "${target}::${case}"
                 COMMAND "${CMAKE_COMMAND}" "-DPROG=$<TARGET_FILE:${target}>"
                         "-DIN=${in}" "-DEXPECTED=${expected}"
                         -P "${LAB_ROOT}/cmake/run_io_test.cmake")
        set_tests_properties("${target}::${case}" PROPERTIES LABELS "${labels}" TIMEOUT 30)
    endforeach()
endfunction()

# 编译一个单元：公共库 <id>_<单元>_core + 每个入口文件一个程序 <id>_<单元>_<文件名>
# kind 为 mine 或 answer；level_id、level_dir、subject、deps 读自调用方 lab_level()
function(_lab_add_unit unit dir kind)
    _lab_split_sources("${dir}" mains others)
    if(NOT mains AND NOT others)
        return()
    endif()
    if(kind STREQUAL "answer")
        set(prefer_answer TRUE)
    else()
        set(prefer_answer FALSE)
    endif()
    set(labels "${subject};${level_id};${kind}")
    _lab_resolve_deps("${deps}" ${prefer_answer} dep_includes dep_targets)
    set(prefix "${level_id}_${unit}")
    if(others)
        add_library("${prefix}_core" STATIC ${others})
        target_include_directories("${prefix}_core" PUBLIC "${dir}" ${dep_includes})
        target_link_libraries("${prefix}_core" PUBLIC ${dep_targets})
    endif()
    foreach(m IN LISTS mains)
        get_filename_component(stem "${m}" NAME_WE)
        set(target "${prefix}_${stem}")
        add_executable("${target}" "${m}")
        target_include_directories("${target}" PRIVATE "${dir}" ${dep_includes})
        if(others)
            target_link_libraries("${target}" PRIVATE "${prefix}_core")
        else()
            target_link_libraries("${target}" PRIVATE ${dep_targets})
        endif()
        _lab_add_tests("${target}" "${stem}" "${level_dir}" "${labels}")
    endforeach()
endfunction()

function(lab_level)
    cmake_parse_arguments(ARG "" "" "DEPS" ${ARGN})
    set(level_dir "${CMAKE_CURRENT_SOURCE_DIR}")
    file(RELATIVE_PATH level_rel "${LAB_ROOT}" "${level_dir}")
    _lab_level_id("${level_rel}" level_id)
    string(REGEX MATCH "^[a-z]+" subject "${level_id}")

    set(deps ${ARG_DEPS})
    if(NOT level_rel STREQUAL LAB_WARMUP)
        list(PREPEND deps "${LAB_WARMUP}")
    endif()

    file(GLOB attempts LIST_DIRECTORIES true CONFIGURE_DEPENDS "${level_dir}/mine/*")
    foreach(a IN LISTS attempts)
        if(IS_DIRECTORY "${a}")
            get_filename_component(unit "${a}" NAME)
            _lab_add_unit("${unit}" "${a}" mine)
        endif()
    endforeach()
    if(IS_DIRECTORY "${level_dir}/answer")
        _lab_add_unit(answer "${level_dir}/answer" answer)
    endif()
endfunction()
